rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// members/{uid}: name, displayRole, role, active. No PII is stored.
//   Public-to-team display fields; role is immutable after registration.
// marks/{markId}: v (0/1), t, by, role, uid, updatedAt (timestamp).
// asist/{YYYY-MM-DD_u0..u4}: d, p, r, t, at, uid, createdAt (timestamp).
// observaciones/{id}: PO-authored feedback; the assigned Developer may update response/status.
// Only the Product Owner manages observations; assigned Developers respond.
// validacionesSemanales/{week-01..week-15[-entry-id]}: shared QA test results.
// aprobacionesRequisitos/{RF-01..RF-32}: Product Owner acceptance by sprint.
// retrospectivaLikert/{sm|po|fe|be|qa}: one week-15 response per team role.
// evaluaciones/final-review: Scrum Master-only project evaluation.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAnonymous() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isActiveMember() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    function member() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function roleMatchesIndex(attendanceId) {
      return (member().role == 'sm' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u0$'))
        || (member().role == 'po' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u1$'))
        || (member().role == 'fe' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u2$'))
        || (member().role == 'be' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u3$'))
        || (member().role == 'qa' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u4$'));
    }

    function validMarkId(markId) {
      return markId.matches('^(g(0|[1-9]|[12][0-9]|3[0-9])|rf-v2_RF-(0[1-9]|[12][0-9]|3[0-2])|rnf-v2_RNF-(0[1-9]|1[01])|c(0?[1-9]|1[0-4])[mder]|[tm]_(po|sm|fe|be|qa)_[0-9]{1,2})$');
    }

    function validMark(markId) {
      return validMarkId(markId)
        && request.resource.data.keys().hasAll([
          'v', 't', 'by', 'role', 'uid', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'v', 't', 'by', 'role', 'uid', 'updatedAt'
        ])
        && request.resource.data.v in [0, 1]
        && request.resource.data.t is string
        && request.resource.data.t.size() <= 40
        && request.resource.data.by == member().name
        && request.resource.data.role == member().role
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validAttendance(attendanceId) {
      return request.resource.data.keys().hasAll([
          'd', 'p', 'r', 't', 'at', 'uid', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'd', 'p', 'r', 't', 'at', 'uid', 'createdAt'
        ])
        && request.resource.data.d is string
        && request.resource.data.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u[0-9]+$')
        && roleMatchesIndex(attendanceId)
        && attendanceId.split('_u')[0] == request.resource.data.d
        && request.resource.data.p == member().name
        && request.resource.data.r == member().displayRole
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is string
        && request.resource.data.t.size() <= 40
        && request.resource.data.at is string
        && request.resource.data.at.size() <= 40
        && request.resource.data.createdAt == request.time;
    }

    function validProjectChecksReset() {
      return request.resource.data.keys().hasAll(['version', 'uid', 'resetAt'])
        && request.resource.data.keys().hasOnly(['version', 'uid', 'resetAt'])
        && request.resource.data.version == 4
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.resetAt == request.time;
    }

    function validWeeklyValidation(weekId) {
      return weekId.matches('^week-(0[1-9]|1[0-5])(-entry-[A-Za-z0-9_-]{1,128})?$')
        && request.resource.data.keys().hasAll([
          'week', 'validated', 'testSummary', 'observation',
          'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'week', 'validated', 'testSummary', 'observation',
          'updatedBy', 'updatedUid', 'updatedAt', 'title'
        ])
        && (!('title' in request.resource.data)
          || (request.resource.data.title is string
            && request.resource.data.title.size() <= 120))
        && request.resource.data.week is int
        && request.resource.data.week >= 1
        && request.resource.data.week <= 15
        && request.resource.data.validated is bool
        && request.resource.data.testSummary is string
        && request.resource.data.testSummary.size() > 0
        && request.resource.data.testSummary.size() <= 2000
        && request.resource.data.observation is string
        && request.resource.data.observation.size() <= 1000
        && request.resource.data.updatedBy == member().name
        && member().role == 'qa'
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validRequirementApproval(requirementId) {
      return requirementId.matches('^RF-(0[1-9]|[12][0-9]|3[0-2])$')
        && request.resource.data.keys().hasAll([
          'requirement', 'status', 'comment', 'sprint',
          'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requirement', 'status', 'comment', 'sprint',
          'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.requirement == requirementId
        && request.resource.data.status in ['Pendiente', 'Aprobado', 'Observado']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.sprint is int
        && request.resource.data.sprint >= 1
        && request.resource.data.sprint <= 4
        && (
          (requirementId.matches('^RF-(0[1-6])$') && request.resource.data.sprint == 1)
          || (requirementId.matches('^RF-(0[7-9]|1[0-8])$') && request.resource.data.sprint == 2)
          || (requirementId.matches('^RF-(1[9]|2[0-7])$') && request.resource.data.sprint == 3)
          || (requirementId.matches('^RF-(2[8-9]|3[0-2])$') && request.resource.data.sprint == 4)
        )
        && request.resource.data.updatedBy == member().name
        && member().role == 'po'
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validTeamRetrospective(uid) {
      return uid == request.auth.uid
        // 2026-11-30 05:00Z is midnight in Lima, when week 15 begins.
        && request.time >= timestamp.value(1796014800000)
        && request.resource.data.keys().hasAll([
          'week', 'role', 'name', 'answers', 'uid', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'week', 'role', 'name', 'answers', 'uid', 'updatedAt'
        ])
        && request.resource.data.week == 15
        && request.resource.data.week is int
        && member().role in ['sm', 'po', 'fe', 'be', 'qa']
        && request.resource.data.role == member().role
        && request.resource.data.name == member().name
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().hasAll([
          'time', 'improvements', 'implementation', 'collaboration', 'value'
        ])
        && request.resource.data.answers.keys().hasOnly([
          'time', 'improvements', 'implementation', 'collaboration', 'value'
        ])
        && request.resource.data.answers.time is int
        && request.resource.data.answers.time >= 1
        && request.resource.data.answers.time <= 5
        && request.resource.data.answers.improvements is int
        && request.resource.data.answers.improvements >= 1
        && request.resource.data.answers.improvements <= 5
        && request.resource.data.answers.implementation is int
        && request.resource.data.answers.implementation >= 1
        && request.resource.data.answers.implementation <= 5
        && request.resource.data.answers.collaboration is int
        && request.resource.data.answers.collaboration >= 1
        && request.resource.data.answers.collaboration <= 5
        && request.resource.data.answers.value is int
        && request.resource.data.answers.value >= 1
        && request.resource.data.answers.value <= 5;
    }

    function validObservation() {
      return request.resource.data.keys().hasAll([
          'requirement', 'developer', 'priority', 'text', 'author', 'authorUid', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requirement', 'developer', 'priority', 'text', 'author', 'authorUid', 'createdAt'
        ])
        && request.resource.data.requirement is string
        && request.resource.data.requirement.matches('^RF-(0[1-9]|[12][0-9]|3[0-2])$')
        && request.resource.data.developer in ['fe', 'be']
        && request.resource.data.priority in ['Normal', 'Alta', 'Bloqueante']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.author == member().name
        && member().role == 'po'
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function validObservationEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'requirement', 'developer', 'priority', 'text',
          'updatedBy', 'updatedUid', 'updatedAt', 'developerStatus',
          'developerResponse', 'developerUpdatedBy', 'developerUpdatedUid',
          'developerUpdatedAt'
        ])
        && request.resource.data.requirement is string
        && request.resource.data.requirement.matches('^RF-(0[1-9]|[12][0-9]|3[0-2])$')
        && request.resource.data.developer in ['fe', 'be']
        && request.resource.data.priority in ['Normal', 'Alta', 'Bloqueante']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.author == resource.data.author
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.resource.data.developer == resource.data.developer
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'developerStatus', 'developerResponse', 'developerUpdatedBy',
              'developerUpdatedUid', 'developerUpdatedAt'
            ]))
          || (request.resource.data.developer != resource.data.developer
            && request.resource.data.developerStatus == 'Pendiente'
            && request.resource.data.developerResponse == ''
            && request.resource.data.developerUpdatedBy == member().name
            && request.resource.data.developerUpdatedUid == request.auth.uid
            && request.resource.data.developerUpdatedAt == request.time)
        )
        && request.resource.data.updatedBy == member().name
        && member().role == 'po'
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validObservationResponse() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'developerStatus', 'developerResponse', 'developerUpdatedBy',
          'developerUpdatedUid', 'developerUpdatedAt'
        ])
        && resource.data.developer == member().role
        && member().role in ['fe', 'be']
        && (!('developerStatus' in resource.data)
          || resource.data.developerStatus != 'Resuelta'
          || request.resource.data.developerStatus == 'Resuelta')
        && request.resource.data.developerStatus in ['En curso', 'Resuelta']
        && request.resource.data.developerResponse is string
        && request.resource.data.developerResponse.size() <= 1000
        && (request.resource.data.developerStatus != 'Resuelta'
          || request.resource.data.developerResponse.size() > 0)
        && request.resource.data.developerUpdatedBy == member().name
        && request.resource.data.developerUpdatedUid == request.auth.uid
        && request.resource.data.developerUpdatedAt == request.time;
    }

    function validEvaluation() {
      return request.resource.data.keys().hasAll([
          'approval', 'grade', 'teacherNote', 'nextAction', 'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'approval', 'grade', 'teacherNote', 'nextAction', 'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.approval in ['Pendiente', 'Sí', 'No']
        && request.resource.data.grade is string
        && request.resource.data.grade.size() <= 40
        && request.resource.data.teacherNote is string
        && request.resource.data.teacherNote.size() <= 500
        && request.resource.data.nextAction is string
        && request.resource.data.nextAction.size() <= 500
        && request.resource.data.updatedBy == member().name
        && member().role == 'sm'
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validDriveLink() {
      return request.resource.data.keys().hasAll([
          'url', 'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'url', 'updatedBy', 'updatedUid', 'updatedAt'
        ])
        && request.resource.data.url is string
        && request.resource.data.url.size() > 10
        && request.resource.data.url.size() <= 1900
        && request.resource.data.url.matches('^https?://.+$')
        && request.resource.data.updatedBy == member().name
        && member().role == 'sm'
        && request.resource.data.updatedUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /members/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isAnonymous()
        && isOwner(uid)
        && request.resource.data.keys().hasAll(['name', 'displayRole', 'role', 'active'])
        && request.resource.data.keys().hasOnly(['name', 'displayRole', 'role', 'active'])
        && request.resource.data.active == true
        && (
          (request.resource.data.name == 'Piero'
            && request.resource.data.displayRole == 'Scrum Master'
            && request.resource.data.role == 'sm')
          || (request.resource.data.name == 'María'
            && request.resource.data.displayRole == 'Product Owner'
            && request.resource.data.role == 'po')
          || (request.resource.data.name == 'Airton'
            && request.resource.data.displayRole == 'Developer 1 · Front End'
            && request.resource.data.role == 'fe')
          || (request.resource.data.name == 'Dayron'
            && request.resource.data.displayRole == 'Developer 2 · Back End'
            && request.resource.data.role == 'be')
          || (request.resource.data.name == 'Patricia'
            && request.resource.data.displayRole == 'Stakeholder · QA'
            && request.resource.data.role == 'qa')
        );
      allow update, delete: if false;
    }

    match /projectSettings/{settingId} {
      allow get: if isActiveMember() && settingId == 'drive-evidence';
      allow list: if false;
      allow create, update: if isActiveMember()
        && settingId == 'drive-evidence'
        && member().role == 'sm'
        && validDriveLink();
      allow delete: if false;
    }

    match /marks/{markId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && validMark(markId);
      allow delete: if isActiveMember() && validMarkId(markId);
    }

    match /asist/{attendanceId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && validAttendance(attendanceId);
      allow update, delete: if false;
    }

    match /meta/{metaId} {
      allow get: if isActiveMember() && metaId == 'project-gantt-checks-reset-2026-11';
      allow list: if false;
      allow create: if isActiveMember()
        && metaId == 'project-gantt-checks-reset-2026-11'
        && validProjectChecksReset();
      allow update, delete: if false;
    }

    match /validacionesSemanales/{weekId} {
      allow read: if isActiveMember()
        && (member().role == 'qa' || resource.data.validated == true);
      allow create, update: if isActiveMember()
        && member().role == 'qa'
        && validWeeklyValidation(weekId);
      allow delete: if isActiveMember()
        && member().role == 'qa'
        && weekId.matches('^week-(0[1-9]|1[0-5])(-entry-[A-Za-z0-9_-]{1,128})?$');
    }

    match /aprobacionesRequisitos/{requirementId} {
      allow read: if isActiveMember() && member().role in ['po', 'fe', 'be'];
      allow create, update: if isActiveMember()
        && member().role == 'po'
        && validRequirementApproval(requirementId);
      allow delete: if isActiveMember()
        && member().role == 'po'
        && requirementId.matches('^RF-(0[1-9]|[12][0-9]|3[0-2])$');
    }

    match /retrospectivaLikert/{uid} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && validTeamRetrospective(uid);
      allow delete: if false;
    }

    match /observaciones/{observationId} {
      allow read: if isActiveMember()
        && (member().role == 'po'
          || (member().role in ['fe', 'be']
            && resource.data.developer == member().role));
      allow create: if isActiveMember() && validObservation();
      allow update: if isActiveMember()
        && (validObservationResponse()
          || (member().role == 'po' && validObservationEdit()));
      allow delete: if isActiveMember() && member().role == 'po';
    }

    match /evaluaciones/{evaluationId} {
      allow read: if isActiveMember()
        && member().role == 'sm'
        && evaluationId == 'final-review';
      allow create, update: if isActiveMember()
        && member().role == 'sm'
        && evaluationId == 'final-review'
        && validEvaluation();
      allow delete: if false;
    }
  }
}
