rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isStakeholder(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.role == 'qa';
    }

    function validWeek(week) {
      return week.matches('^semana-(1[0-4]|[1-9])$');
    }

    function validEvidence(week) {
      return validWeek(week)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(application/msword|application/vnd\\.ms-excel|application/vnd\\.ms-powerpoint|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation))$'
        );
    }

    match /validaciones/{uid}/{week}/{fileName} {
      allow read: if isStakeholder(uid) && validWeek(week);
      allow create, update: if isStakeholder(uid) && validEvidence(week);
      allow delete: if isStakeholder(uid) && validWeek(week);
    }
  }
}
